<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OnlySex" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#12090F</item>
        <item name="android:navigationBarColor">#12090F</item>
